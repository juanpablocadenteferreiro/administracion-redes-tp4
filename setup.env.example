# Copiar a setup.env y editar (setup.env esta en .gitignore).
# Todas las variables son opcionales: si no se definen, se usan estos valores por defecto.

# --- VPN ---------------------------------------------------------------------
VPN_PREFIX=10.8.0            # red de la VPN: 10.8.0.0/24  (el servidor es el .1)
WG_PORT=51820                # puerto UDP de WireGuard
WG_ENDPOINT=                 # IP o DNS PUBLICO del servidor (lo que usan los clientes). Vacio = autodetecta
VPN_CLIENTS="cliente1 cliente2"   # clientes VPN a crear (uno por integrante / dispositivo)

# --- SSH ---------------------------------------------------------------------
SSH_ALLOW_FROM="0.0.0.0/0"   # origenes autorizados para SSH publico (puerto 22). Ej: "190.1.2.3, 200.4.5.0/24"

# --- Usuarios del sistema (cada uno tendra /home/<u>/public_html) -------------
USERS="kakashi sakura"

# --- Bonus: autenticacion HTTP basica para /~usuario/privado/ ------------------
WEB_AUTH_USER=admin
WEB_AUTH_PASS=               # vacio = se genera una al azar y se guarda en /root/tp2-credenciales.txt

# --- Backup ------------------------------------------------------------------
BACKUP_DEST=/var/backups/home
BACKUP_CRON="0 * * * *"      # cada hora. Para la demo se puede usar "*/10 * * * *"
BACKUP_KEEP_DAYS=14
